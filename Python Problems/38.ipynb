   "source": [
    "### 38. Take a number from the user and find the number of digits in it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "54ab7c21",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "11\n"
     ]
    }
   ],
   "source": [
    "# 1st solution\n",
    "\n",
    "num = 84732897423\n",
    "digit = 0\n",
    "\n",
    "while num != 0:\n",
    "    num = num // 10\n",
    "    digit = digit + 1\n",
    "    \n",
    "print(digit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "14dae591",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "6\n"
     ]
    }
   ],
   "source": [
    "# 2nd solution\n",
    "\n",
    "num = 321434\n",
    "\n",
    "digits = len(str(num))\n",
    "\n",
    "print(digits)"
   ]
  },
