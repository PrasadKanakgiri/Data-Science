   "source": [
    "def fibonacci(num):\n",
    "    if num <= 1:\n",
    "        return num   # fib(0) = 0, fib(1) = 1\n",
    "    \n",
    "    return fibonacci(num-1) + fibonacci(num-2)\n",
    "\n",
    "for i in range(26):\n",
    "    print(fibonacci(i))"
   ]
