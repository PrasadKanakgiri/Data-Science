   "source": [
    "### 40. Find the reverse of a number provided by the user(any number of digit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "7cf2504e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1234\n",
      "4321\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter the number: \"))\n",
    "\n",
    "print(n)\n",
    "num = str(n)\n",
    "\n",
    "reverse = num[::-1]\n",
    "\n",
    "print(int(reverse))"
   ]
