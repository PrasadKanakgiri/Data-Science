   "source": [
    "### 55. Count the number of vowels in a string provided by the user."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02b8b62e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vowels in jasdncuaisdgfhjaewbflu are: 7\n"
     ]
    }
   ],
   "source": [
    "vowels = ['a', 'e', 'i', 'o', 'u']\n",
    "\n",
    "s = input(\"Enter the string: \")\n",
    "\n",
    "count = 0\n",
    "\n",
    "for i in s:\n",
    "    if i.lower() in vowels:\n",
    "        count = count + 1\n",
    "        \n",
    "print(f\"Vowels in {s} are: {count}\")"
   ]
  },
