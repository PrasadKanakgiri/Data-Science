   "source": [
    "### 39. Print all factors of a given number provided by the user."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "57c77c32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "40\n",
      "[1, 2, 4, 5, 8, 10, 20, 40]\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter the number: \"))\n",
    "\n",
    "print(n)\n",
    "l = []\n",
    "for i in range(1, n + 1):\n",
    "    if n % i == 0:\n",
    "        l.append(i)\n",
    "\n",
    "print(l)"
   ]
  },
