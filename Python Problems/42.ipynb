   "source": [
    "### 42. Write a program to print the following pattern \n",
    "```text\n",
    "* \n",
    "** \n",
    "*** \n",
    "** \n",
    "*\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "e5597e32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "*\n",
      "**\n",
      "***\n",
      "**\n",
      "*\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter the number: \"))\n",
    "\n",
    "for i in range(1, n // 2 + 2):\n",
    "    print(\"*\" * i)\n",
    "\n",
    "for i in range(n // 2, 0, -1):\n",
    "    print(\"*\" * i)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "00cac91d",
   "metadata": {},
