   "source": [
    "### 60. Write a python program to find the max item from a list without using the max function "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "50bf8268",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "100\n"
     ]
    }
   ],
   "source": [
    "l = [80, 30, 60, 50, 100, 20, 70, 40]\n",
    "\n",
    "max_num = l[0]\n",
    "\n",
    "for i in l:\n",
    "    if i > max_num:\n",
    "        max_num = i\n",
    "\n",
    "print(max_num)\n",
    "\n"
   ]
  },
